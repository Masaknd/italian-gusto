# MicroCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# Server-only translator key: Content API GET/PATCH and Management API content GET.
MICROCMS_TRANSLATION_API_KEY=
# HMAC secret configured on the MicroCMS custom webhook.
MICROCMS_WEBHOOK_SECRET=
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DeepL Translation
DEEPL_API_KEY=
# Public HTTPS origin used for queue callbacks (server-only setting).
TRANSLATION_SITE_URL=
QSTASH_TOKEN=
# Copy the API URL and both signing keys from the same QStash region.
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TRANSLATION_QUEUE=gusto-menu-translations
# Authenticates daily reconciliation; set a random secret in production.
CRON_SECRET=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional, use actual venue destinations only
SOCIAL_TWITTER_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_BLOG_URL=

# Google Site Verification
GOOGLE_SITE_VERIFICATION=
